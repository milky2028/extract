#!/usr/bin/env bash
# Builds dist/ from src/extract.cpp.
#
#   LIBARCHIVE_PREFIX=/path/to/libarchive-dist ./compile
#
# LIBARCHIVE_PREFIX is the install prefix produced by scripts/build-libarchive.sh.
set -euo pipefail

: "${LIBARCHIVE_PREFIX:?set LIBARCHIVE_PREFIX (see scripts/build-libarchive.sh)}"

rm -rf dist && mkdir dist

common=(
  src/extract.cpp
  -std=c++20
  -I"$LIBARCHIVE_PREFIX/include"
  -L"$LIBARCHIVE_PREFIX/lib"
  -larchive
  -sUSE_ZLIB=1
  -sUSE_BZIP2=1
  -lembind
  -sEXPORT_ES6
  -sALLOW_MEMORY_GROWTH
  -sSTACK_SIZE=1MB
  -sFILESYSTEM=0 # libarchive reads through JS callbacks; no Emscripten FS
  -fno-exceptions
  --pre-js src/locateFile.js
)

# Browser build: runs in a dedicated worker; the source's read() uses FileReaderSync.
browser=(-sENVIRONMENT=worker)

em++ "${common[@]}" "${browser[@]}" -O3 -flto -o dist/extract.js
em++ "${common[@]}" "${browser[@]}" -O0 -g -sASSERTIONS=2 -o dist/extract.debug.js

# Node build: same API, the source's read() uses fs.readSync. Used by the test suite.
em++ "${common[@]}" -sENVIRONMENT=node -O3 -o dist/extract.node.js

cp src/extract.d.ts dist/extract.d.ts

ls -la dist
