{
  "name": "extract-zip-rar",
  "version": "1.0.0",
  "description": "libarchive compiled to WebAssembly: stream .zip/.cbz and .rar/.cbr archives of any size.",
  "type": "module",
  "main": "./dist/extract.js",
  "types": "./dist/extract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js"
    },
    "./node": {
      "import": "./dist/extract.node.js"
    },
    "./wasm": "./dist/extract.wasm",
    "./debug": "./dist/extract.debug.js",
    "./debug.wasm": "./dist/extract.debug.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "author": "Tyler Gross",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
